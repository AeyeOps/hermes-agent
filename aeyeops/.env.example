# Copy to aeyeops/.env on each host and fill with local paths/service names.
# aeyeops/.env is intentionally ignored by git.

HERMES_HOME=<HERMES_HOME>
CODEX_HOME=<CODEX_HOME>
HERMES_BIN=<HERMES_BIN>

LITELLM_CHATGPT_AUTH=<LITELLM_CHATGPT_AUTH_JSON>
LITELLM_ENV_FILE=<LITELLM_ENV_FILE>
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_MODEL_ALIAS=hindsight-codex
LITELLM_SERVICE=<LITELLM_SERVICE>

CODEX_REBIND_PREFER=newest
CODEX_REBIND_VALIDATE=true

# AEyeOps portal defaults. Keep real hostnames, local paths, and password-hash
# files in ignored aeyeops/.env only. The portal installer writes Caddy HTTPS
# snippets protected by Authelia forward_auth.
AEX_DASHBOARD_DOMAIN=<DASHBOARD_DOMAIN>
AEX_WEBUI_DOMAIN=<WEBUI_DOMAIN>
AEX_MC_DOMAIN=<MISSION_CONTROL_DOMAIN>
AEX_AUTHELIA_DOMAIN=<AUTH_DOMAIN>
AEX_CALLBACK_DOMAIN=<CALLBACK_DOMAIN>
AEX_AUTHELIA_DOMAIN_ROOT=<COOKIE_DOMAIN>
AEX_AUTHELIA_USER=<AUTHELIA_USER>
AEX_AUTHELIA_USER_EMAIL=<AUTHELIA_USER_EMAIL>
AEX_AUTHELIA_DISPLAY_NAME=<AUTHELIA_DISPLAY_NAME>
AEX_AUTHELIA_USER_PASSWORD_HASH_FILE=<AUTHELIA_PASSWORD_HASH_FILE>
AEX_AUTHELIA_USER_PASSWORD_FILE=<AUTHELIA_PASSWORD_FILE>
AEX_INSTALL_AUTHELIA=1

AEX_DASHBOARD_PORT=9119
AEX_WEBUI_PORT=8787
AEX_MC_PORT=3000
AEX_AUTHELIA_PORT=9091
AEX_HERMES_API_PORT=8642
AEX_AUTHELIA_CONFIG_DIR=<AUTHELIA_CONFIG_DIR>
AEX_INSTALL_ROOT=<AEX_INSTALL_ROOT>
AEX_WEBUI_DIR=<HERMES_WEBUI_DIR>
AEX_MC_DIR=<MISSION_CONTROL_DIR>
AEX_WEBUI_REPO=https://github.com/nesquena/hermes-webui.git
AEX_MC_REPO=https://github.com/builderz-labs/mission-control.git
AEX_WEBUI_REF=master
AEX_MC_REF=main
AEX_HERMES_API_KEY_FILE=<HERMES_API_KEY_FILE>
AEX_NODE_BIN_DIR=<NODE_BIN_DIR>
AEX_PNPM_VERSION=10.24.0
HERMES_REPO_DIR=<HERMES_REPO_DIR>

# Google Chat platform. Use canonical GOOGLE_CHAT_* names.
GOOGLE_CHAT_PROJECT_ID=<GCP_PROJECT_ID>
GOOGLE_CHAT_SUBSCRIPTION_NAME=projects/<GCP_PROJECT_ID>/subscriptions/<PUBSUB_SUBSCRIPTION>
GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=<GOOGLE_CHAT_SERVICE_ACCOUNT_JSON_OR_PATH>
GOOGLE_CHAT_ALLOWED_USERS=<COMMA_SEPARATED_EMAILS>
GOOGLE_CHAT_HOME_CHANNEL=<GOOGLE_CHAT_SPACE_RESOURCE>
AEX_GOOGLE_CHAT_ADDON_SERVICE_ACCOUNT_EMAIL=<WORKSPACE_ADDON_SERVICE_ACCOUNT_EMAIL>
AEX_GOOGLE_CHAT_PROJECT_NUMBER=<GOOGLE_CLOUD_PROJECT_NUMBER>
AEX_GOOGLE_CHAT_HTTP_EVENTS_SERVICE_ACCOUNT_EMAIL=<CHAT_HTTP_SERVICE_ACCOUNT_EMAIL>
AEX_GOOGLE_CHAT_HTTP_EVENTS_AUDIENCE=<CALLBACK_EVENTS_URL_OR_PROJECT_NUMBER>
GOOGLE_CHAT_CARD_ACTION_TRANSPORT=addon_http

# Optional Cloudflare DNS automation. If credentials are present, the stack
# installer can idempotently upsert dashboard/webui/mc/auth A records before
# Caddy requests certificates. Keep the keys file host-local and ignored.
AEX_CLOUDFLARE_DNS=auto
AEX_CLOUDFLARE_KEYS_FILE=<CLOUDFLARE_KEYS_FILE>
AEX_CLOUDFLARE_ZONE_NAME=<CLOUDFLARE_ZONE_NAME>
AEX_CLOUDFLARE_ZONE_ID=<CLOUDFLARE_ZONE_ID>
AEX_PORTAL_ORIGIN_IP=auto
